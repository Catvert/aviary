[Desktop Entry]
Type=Application
Version=1.0
Name=Aviary
GenericName=Email Client
GenericName[fr]=Client de messagerie
Comment=Email, calendar and kanban for Microsoft 365, Gmail and IMAP
Comment[fr]=Courrier, calendrier et kanban pour Microsoft 365, Gmail et IMAP
# %u passes the clicked mailto: URL. A second launch does not open a second
# window: src/single_instance.rs hands the URL to the running instance over a
# Unix socket and exits, which also protects the session file and the two
# SQLite databases from a concurrent writer.
Exec=aviary %u
Icon=aviary
Terminal=false
# One main category only. Adding Office (for the calendar) makes menus list
# Aviary twice, and desktop-file-validate warns about it.
Categories=Network;Email;
Keywords=email;mail;imap;gmail;calendar;kanban;
Keywords[fr]=courriel;courrier;mail;imap;gmail;calendrier;kanban;
MimeType=x-scheme-handler/mailto;
# Wayland matches a window to this file through its app_id, which ui/mod.rs
# sets to "aviary" in WindowOptions. Both must stay equal or the launcher shows
# a generic icon in the dock. Renaming this file to a reverse-DNS id (needed
# for Flathub) means changing that app_id in the same commit.
StartupWMClass=aviary
StartupNotify=true
